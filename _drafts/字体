/* 字体声明 */
@font-face {
    font-family: 'Lexend';
    src: url('fonts/Lexend-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Lexend';
    src: url('fonts/Lexend-Medium.ttf') format('truetype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Lexend';
    src: url('fonts/Lexend-SemiBold.ttf') format('truetype');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Lexend';
    src: url('fonts/Lexend-Bold.ttf') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Lexend';
    src: url('fonts/Lexend-Thin.ttf') format('truetype');
    font-weight: 100;
    /* Thin */
    font-style: normal;
    font-display: swap;
}

/* 添加 Lexend-ExtraLight 字体声明 */
@font-face {
    font-family: 'Lexend';
    src: url('fonts/Lexend-ExtraLight.ttf') format('truetype');
    font-weight: 200;
    /* Extra Light */
    font-style: normal;
    font-display: swap;
}